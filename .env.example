# Ejemplo de configuracion de MarkPDF. TODOS los valores son ficticios: no pongas secretos reales en este archivo.
# MarkPDF no lee archivos .env por si sola: exporta estas variables en tu shell o cargalas con tu gestor de despliegue.
# Todas son opcionales; sin ellas la aplicacion funciona en local sin login.

# --- Entorno y limites ---
# Con production: oculta /docs, anade HSTS y desactiva la extraccion de imagenes.
# MARKPDF_ENV=production
MARKPDF_MAX_UPLOAD_MB=10
MARKPDF_MAX_PAGES=100
MARKPDF_MAX_DOWNLOAD_MB=5
MARKPDF_MAX_CONCURRENT=1
# Conversiones por IP y hora; solo rige sin login. 0 = sin limite.
MARKPDF_RATE_LIMIT_PER_HOUR=10
# Numero de proxies de confianza delante de la app (1 si hay un balanceador).
MARKPDF_TRUSTED_PROXY_HOPS=0
# Por defecto es false si MARKPDF_ENV=production.
MARKPDF_ENABLE_IMAGE_EXTRACT=true

# --- Google Login y cuotas (solo si MARKPDF_AUTH_ENABLED=true) ---
MARKPDF_AUTH_ENABLED=false
DATABASE_URL=postgresql://usuario:clave@localhost:5432/markpdf
# Cadena aleatoria de al menos 32 caracteres.
MARKPDF_SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret-de-google
# URL publica de la app. Google debe autorizar <URL>/auth/callback como redireccion.
MARKPDF_PUBLIC_URL=https://markpdf.example.com
MARKPDF_DAILY_FREE_CONVERSIONS=3

# --- Rendimiento (opcional) ---
# Desactiva el log de tiempos y memoria de /convert.
# MARKPDF_PERF_LOG=false
# Limita los hilos de ONNX Runtime (contenedores con poca CPU).
# MARKPDF_ORT_THREADS=1
